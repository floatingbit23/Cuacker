# Doxyfile for Cuacker project

# Project settings
PROJECT_NAME           = "Cuacker"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Spanish
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
JAVADOC_AUTOBRIEF      = YES

# Input settings
INPUT                  = README.md README_EN.md include src
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.md
EXCLUDE                = lib/sqlite3.c lib/sqlite3.h
FILTER_PATTERNS        = *.md="python doxygen_filter.py"

# Build settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES

# HTML settings
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    =.html
GENERATE_TREEVIEW      = YES
USE_MATHJAX            = YES

# LaTeX settings
GENERATE_LATEX         = NO

# Formatting
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
